*.mdb
*.opendb
*.VC.db
ExportedObj/
.consulo/

# Unity crash / build artifacts
sysinfo.txt
crashlytics-build.properties
*.apk
*.aab
*.unitypackage
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# OS
.DS_Store
Thumbs.db

# Mixamo round trip (source upload and download), not part of the project
/Mixamo/

# Written into Assets/Resources by the Performance Testing package on every player build
Assets/Resources/PerformanceTestRun*
Assets/Resources.meta

# Public repo: paid Asset Store packs are never committed (buy and import them yourself; see README)
/Assets/External/FantasyForest/
/Assets/External/FantasyForest.meta
/Assets/External/FantasyValley/
/Assets/External/FantasyValley.meta
/Assets/External/CartoonGrass/
/Assets/External/CartoonGrass.meta
# Built from the packs' trees by Tools/Cabin/Map (copies of the packs' meshes)
/Assets/Generated/Trees/
/Assets/Generated/Trees.meta
